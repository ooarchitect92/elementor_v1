# Local development only. `npm run bootstrap` generates random local credentials.
COMPOSE_PROJECT_NAME=forgestudio
POSTGRES_DB=forgestudio
POSTGRES_USER=forgestudio
POSTGRES_PASSWORD=GENERATE_LOCALLY
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
PLATFORM_DATABASE_URL=

REDIS_PASSWORD=GENERATE_LOCALLY
REDIS_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CONTROL_PORT=6380
REDIS_CACHE_URL=
REDIS_CONTROL_URL=

RABBITMQ_USER=forgestudio
RABBITMQ_PASSWORD=GENERATE_LOCALLY
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT_SECONDS=20
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_CONFIRM_TIMEOUT_MS=10000
RABBITMQ_CONSUMER_PREFETCH=8
RABBITMQ_URL=

KAFKA_PORT=9094
KAFKA_BROKERS=
KAFKA_CLIENT_ID=forgestudio-outbox
KAFKA_CONNECT_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=15000
KAFKA_CONNECT_RETRIES=8

# AES-256-GCM key for private release configuration. Store in a secret manager in production.
INTEGRATION_SECRET_KEY_BASE64=GENERATE_BASE64_32

WORKER_TENANT_IDS=
OUTBOX_BATCH_SIZE=32
OUTBOX_IDLE_MS=250
LEASE_RECOVERY_INTERVAL_MS=10000
SERVICE_NAME=forgestudio-worker

WORDPRESS_PORT=8081
WORDPRESS_DB_PASSWORD=GENERATE_LOCALLY
WORDPRESS_DB_ROOT_PASSWORD=GENERATE_LOCALLY

POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
RABBITMQ_IMAGE=rabbitmq:4.1-management-alpine
KAFKA_IMAGE=apache/kafka:4.0.0
WORDPRESS_IMAGE=wordpress:6-php8.3-apache
MARIADB_IMAGE=mariadb:11.4
