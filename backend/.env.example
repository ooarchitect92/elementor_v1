NODE_ENV=development

PORT=5000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32 random bytes encoded as base64. Generate locally, store as a secret, and rotate through a reviewed procedure.
# Example generation: openssl rand -base64 32
WORDPRESS_SECRET_KEY_BASE64=

# Request body caps. Increase only with explicit upload/editor evidence.
JSON_BODY_LIMIT=5mb
FORM_BODY_LIMIT=1mb

# In-process legacy snippet scheduling is development-only, not a durable worker.
ENABLE_LEGACY_SCHEDULER=false
