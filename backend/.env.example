NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

REDIS_PASSWORD=
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CONTROL_HOST=127.0.0.1
REDIS_CONTROL_PORT=6380
REDIS_CONNECT_TIMEOUT_MS=1500
SESSION_CACHE_TTL_SECONDS=15
SESSION_ACTIVITY_INTERVAL_SECONDS=300
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=5

# Independent AES-256-GCM keys encoded as base64; store and rotate through a secret manager.
INTEGRATION_SECRET_KEY_BASE64=
WORDPRESS_SECRET_KEY_BASE64=

JSON_BODY_LIMIT=5mb
FORM_BODY_LIMIT=1mb
PUBLISH_JOB_DEADLINE_SECONDS=900
INTEGRATION_JOB_DEADLINE_SECONDS=86400
WORDPRESS_SYNC_DEADLINE_SECONDS=3600
ENABLE_LEGACY_SCHEDULER=false
