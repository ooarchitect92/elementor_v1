{
  "version": 3,
  "enabled": true,
  "leaseRecoveryImplemented": true,
  "infrastructureRuntimes": [
    {
      "id": "tenant-outbox-relay",
      "entrypoint": "workers/outbox/main.ts",
      "status": "implemented",
      "destinations": ["rabbitmq", "kafka"]
    }
  ],
  "handlers": [
    {
      "queue": "publish.build",
      "entrypoint": "workers/publish/main.ts",
      "adapter": "forgestudio.database-release.v1",
      "sideEffects": "idempotent",
      "status": "implemented-and-integration-gated"
    }
  ],
  "disabledQueues": [
    "wordpress.sync",
    "media.process",
    "integration.deliver",
    "maintenance.reconcile"
  ],
  "reason": "The database-backed publish adapter is enabled with durable lease, outbox and idempotent release evidence. Other domain adapters remain disabled until each has provider-specific failure and reconciliation evidence."
}
